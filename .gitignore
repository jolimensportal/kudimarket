# Dependencies. Never committed, never linted: kudilint reads app/vendor and app/public, which
# produced 1552 phantom errors until they were exempted.
app/vendor/
app/node_modules/
node_modules/
vendor/

# Build output
app/public/build/
app/public/hot
app/public/storage
build/
dist/
coverage/

# Secrets. .env holds real database credentials for the local Postgres cluster; .env.example is the
# template and is committed.
.env
app/.env
app/.env.*
!app/.env.example

# Laravel and framework noise
app/storage/*.key
app/storage/framework/cache/data/*
app/storage/framework/sessions/*
app/storage/framework/views/*
app/storage/logs/*.log
app/bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache/
app/.phpunit.result.cache
app/.phpunit.cache/
npm-debug.log*
yarn-error.log*

# The local Postgres cluster lives inside the repo and is gigabytes of binary.
kudi-core/pgdata/
# The cluster's server log. It was committed by accident and has been rewritten by every test run since,
# which puts a wall of timestamped log noise in the diff of any real change.
kudi-core/pg.log

# macOS
.DS_Store
# Never commit a private key. The live one lives in ~/.ssh/KudiMarket.pem, outside the repo;
# this is here so that copying one in by accident cannot stage it.
*.pem
*.key

# Session scratch from the brainstorming tool, not part of the product.
.superpowers/
