APP_NAME=KudiMarket
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kudimarket.com

# Are we open for business yet? true serves the public landing page and closes the trader app.
# It is false until brand/REGULATORY.md 5b is answered by counsel. Turning it on does not make the
# product legal; it stops the public site inviting trading before we may lawfully do it.
KUDI_LAUNCHING=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# The default connection. This is the connection Laravel's own tables live on:
# users (traders + staff), password_reset_tokens, sessions, cache, jobs.
# It must be the SAME postgres database as the four scoped connections below,
# but it connects as kudi_app_login -- a read-mostly role, not a superuser.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_SOCKET=
DB_PORT=5432
DB_DATABASE=kudi_prod
DB_USERNAME=kudi_app_login
DB_PASSWORD=

# ---------------------------------------------------------------------------
# The four role-scoped connections the application actually works through.
# See docs/production-runbook.md §3. Each role is a separate postgres login;
# the schema grants each exactly the operations its desk is allowed. The app
# holds each password in this file and NEVER connects as the kudi superuser.
# ---------------------------------------------------------------------------

# kudi_trader_login: opens/claims/disputes trades. Host may be a unix socket
# ('' with DB_*_SOCKET=/var/run/postgresql on a same-host install) or TCP.
DB_TRADER_HOST=127.0.0.1
DB_TRADER_PORT=5432
DB_TRADER_DATABASE=kudi_prod
DB_TRADER_USERNAME=kudi_trader_login
DB_TRADER_PASSWORD=

# kudi_pricing_login: publishes rates and commissions.
DB_PRICING_HOST=127.0.0.1
DB_PRICING_PORT=5432
DB_PRICING_DATABASE=kudi_prod
DB_PRICING_USERNAME=kudi_pricing_login
DB_PRICING_PASSWORD=

# kudi_ops_login: attests payments, resolves disputes, sees the whole board.
DB_OPS_HOST=127.0.0.1
DB_OPS_PORT=5432
DB_OPS_DATABASE=kudi_prod
DB_OPS_USERNAME=kudi_ops_login
DB_OPS_PASSWORD=

# kudi: used ONLY by php artisan migrate / the deploy script to build the
# schema. The running application never connects as this role.
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=5432
DB_ADMIN_DATABASE=kudi_prod
DB_ADMIN_USERNAME=kudi
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The application sends no email today, so the log mailer is the honest
# default -- nothing silent is being swallowed. When notifications arrive,
# set MAIL_MAILER=smtp and a real transport before relying on them.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kudimarket.com"
MAIL_FROM_NAME="${APP_NAME}"

# The AWS keys below are the stock Laravel example's S3 defaults. This project
# does not use S3; leave them empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Direct contact routes for the public prelaunch page. Both are optional: the "No email?" row
# is not rendered at all unless at least one is set, so no dead links ship.
KUDI_WHATSAPP_URL=
KUDI_TELEGRAM_URL=
