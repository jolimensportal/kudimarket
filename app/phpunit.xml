<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Postgres, never sqlite. The default Laravel configuration points at an in-memory SQLite
            file, where none of our stored procedures, roles or triggers exist: every test would pass
            while proving nothing about money. Tests build kudi_test from kudi-core/ in
            BuildsLedgerDatabase, so they run against the real schema and the real role limits.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_SOCKET" value="/tmp"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="kudi_test"/>
        <env name="DB_USERNAME" value="kudi_app_login"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_OPS_SOCKET" value="/tmp"/>
        <env name="DB_OPS_PORT" value="5433"/>
        <env name="DB_OPS_DATABASE" value="kudi_test"/>
        <env name="DB_OPS_USERNAME" value="kudi_ops_login"/>
        <env name="DB_OPS_PASSWORD" value=""/>

        <!-- The trader connection, for the same reason: the board must be read as kudi_trader, or a
             test passes against a role the product never uses. -->
        <env name="DB_TRADER_SOCKET" value="/tmp"/>
        <env name="DB_TRADER_PORT" value="5433"/>
        <env name="DB_TRADER_DATABASE" value="kudi_test"/>
        <env name="DB_TRADER_USERNAME" value="kudi_trader_login"/>
        <env name="DB_TRADER_PASSWORD" value=""/>

        <!-- Pricing, because a test must publish a rate through the pricing role and SET ROLE is
             session state that would otherwise leak into every later query on a shared connection. -->
        <env name="DB_PRICING_SOCKET" value="/tmp"/>
        <env name="DB_PRICING_PORT" value="5433"/>
        <env name="DB_PRICING_DATABASE" value="kudi_test"/>
        <env name="DB_PRICING_USERNAME" value="kudi_pricing_login"/>
        <env name="DB_PRICING_PASSWORD" value=""/>

        <!--
            The admin connection too, and this one bit me. It reads DB_ADMIN_DATABASE, not
            DB_DATABASE, so without these lines a test that publishes a rate through the admin
            connection writes it into the development database while the application reads the test
            database. The test then fails with "we have not published a rate" while quietly filling
            kudi_dev with rows. Every connection the application has needs naming here, not just the
            default one.
        -->
        <env name="DB_ADMIN_SOCKET" value="/tmp"/>
        <env name="DB_ADMIN_PORT" value="5433"/>
        <env name="DB_ADMIN_DATABASE" value="kudi_test"/>
        <env name="DB_ADMIN_USERNAME" value="kudi"/>
        <env name="DB_ADMIN_PASSWORD" value=""/>

        <!-- No DB_URL. It overrides every individual setting above and silently wins. -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SESSION_COOKIE" value="kudi-test-session"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
